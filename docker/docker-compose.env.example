# HireMind AI — Environment Overrides for Docker Compose
# Copy to `backend/.env` (already referenced by docker-compose.yml).
# The DB host is the compose service name `db`.

PROJECT_NAME=HireMind AI
API_V1_PREFIX=/api/v1
ENVIRONMENT=production
DEBUG=false

SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=hiremind
POSTGRES_PASSWORD=hiremind
POSTGRES_DB=hiremind_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

LOG_LEVEL=INFO
LOG_FORMAT=json

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=25
