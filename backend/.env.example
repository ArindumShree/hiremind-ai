# Application
PROJECT_NAME=HireMind AI
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
DEBUG=true

# Security — generate a strong secret in production!
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated origins)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=hiremind
POSTGRES_PASSWORD=hiremind
POSTGRES_DB=hiremind_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=25

# AI (Sprint 6 — question generation via NVIDIA's OpenAI-compatible API)
# Get a key at https://build.nvidia.com/ (nvapi-... key)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
